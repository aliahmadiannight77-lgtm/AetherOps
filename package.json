{
  "name": "aetherops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:edge": "npm run build && wrangler dev --config worker/wrangler.toml",
    "deploy": "npm run build && wrangler deploy --config worker/wrangler.toml",
    "db:local": "wrangler d1 migrations apply aetherops --local --config worker/wrangler.toml",
    "db:remote": "wrangler d1 migrations apply aetherops --remote --config worker/wrangler.toml"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.6",
    "@fontsource/vazirmatn": "^5.2.6",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^3.0.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.34",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wrangler": "^4.49.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
